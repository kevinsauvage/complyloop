{
  "name": "compliance-engineering-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "complyloop-check": "./packages/check/bin.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx src/server/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:seed": "tsx scripts/e2e-seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "complyloop-check",
    "build:check": "node scripts/build-check.mjs",
    "playwright:install": "playwright install chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx scripts/run-assessment-worker.ts",
    "ops:check": "tsx scripts/operations-check.ts",
    "ops:backup": "sh scripts/backup-postgres.sh"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@octokit/webhooks-methods": "^6.0.0",
    "@sentry/nextjs": "^10.70.0",
    "ai": "^7.0.51",
    "aria-query": "^5.3.2",
    "axe-core": "^4.13.0",
    "axobject-query": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-glob": "^3.3.3",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "playwright": "^1.62.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.7",
    "ssrf-guard": "^0.6.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/aria-query": "^5.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "nanoid": "^3.3.18"
  }
