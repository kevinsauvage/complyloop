    "ai": "^7.0.51",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "fast-glob": "^3.3.3",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-git": "^3.36.0",
