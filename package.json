{
  "name": "compliance-engineering-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && npm run build",
    "build:core": "npm run build --workspace @complyloop/analysis-core",
    "build:db": "npm run build --workspace @complyloop/db",
    "analyze": "next experimental-analyze --output",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:gate": "sh scripts/verify-gate.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run packages/db/src/alerts-upsert.test.ts packages/db/src/assessment-snapshots.test.ts packages/db/src/constraints.test.ts packages/db/src/evidence-append-only.test.ts packages/db/src/persist-project-rows.integration.test.ts packages/db/src/projects-lookup.test.ts src/server/workspace/workspace.integration.test.ts src/server/assessment/assessment-jobs.concurrency.test.ts",
    "e2e:seed": "tsx --conditions=react-server scripts/e2e-seed.ts",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:reset": "tsx --conditions=react-server scripts/db-reset.ts",
    "db:ensure-owner": "tsx --conditions=react-server scripts/ensure-org-owner.ts",
    "db:studio": "drizzle-kit studio",
    "ops:check": "tsx --conditions=react-server scripts/operations-check.ts",
    "postinstall": "node scripts/postinstall-ssrf-guard.mjs",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:drain": "npm run worker:build && node dist/worker/assessment-worker-drain.cjs"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@octokit/webhooks-methods": "^6.0.0",
    "@sentry/nextjs": "^10.74.0",
    "ai": "^7.0.100",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "isomorphic-git": "^1.35.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/aria-query": "^5.0.4",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "nanoid": "^3.3.18"
  }
}
