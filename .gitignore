# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/.auth/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# local leftover data (unused; Postgres is the store)
/.data

# next.js
/.next/
/out/

# production
/build
/packages/check/dist
*.tgz

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# .opencode
.opencode/

# design system
design-system/
