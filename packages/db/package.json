{
  "name": "@complyloop/db",
  "version": "0.1.0",
  "description": "ComplyLoop Postgres persistence layer — Drizzle schema, repo mappers, workspace load, evidence store. Framework-agnostic; depends on the domain model and analysis contract.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@complyloop/analysis-core": "^0.1.0",
    "drizzle-orm": "^0.45.3"
  },
  "peerDependencies": {
    "postgres": "^3.4.9",
    "typescript": "^5"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js",
        "default": "./dist/*.js"
      }
    }
  }
}
