{
  "name": "@complyloop/analysis-core",
  "version": "0.1.0",
  "description": "ComplyLoop accessibility analysis engine — AST checks, runtime/DOM checks, findings contract. Framework-agnostic, reusable across platform, CI and browser.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract/index.ts",
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.66.0",
    "aria-query": "^5.3.2",
    "axobject-query": "^4.1.0",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-glob": "^3.3.3",
    "html-validate": "^11.12.0",
    "linkinator": "^8.1.0",
    "playwright": "^1.62.1",
    "ssrf-guard": "^0.6.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "axe-core": "^4.13.0"
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/complyloop/compliance-engineering-platform.git",
    "directory": "packages/analysis-core"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./contract": {
        "types": "./dist/contract/index.d.ts",
        "import": "./dist/contract/index.js",
        "default": "./dist/contract/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js",
        "default": "./dist/*.js"
      }
    }
  }
}
