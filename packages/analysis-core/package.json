{
  "name": "@complyloop/analysis-core",
  "version": "0.1.0",
  "description": "ComplyLoop accessibility analysis engine — AST checks, runtime/DOM checks, findings contract. Framework-agnostic, reusable across platform, CI and browser.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "import": "./dist/scan.js"
    },
    "./fixes": {
      "types": "./dist/fixes.d.ts",
      "import": "./dist/fixes.js"
    },
    "./check-authority": {
      "types": "./dist/check-authority.d.ts",
      "import": "./dist/check-authority.js"
    },
    "./merge-findings": {
      "types": "./dist/merge-findings.d.ts",
      "import": "./dist/merge-findings.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "import": "./dist/parse.js"
    },
    "./source-files": {
      "types": "./dist/source-files.d.ts",
      "import": "./dist/source-files.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./workspace-path": {
      "types": "./dist/workspace-path.d.ts",
      "import": "./dist/workspace-path.js"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "import": "./dist/runtime/*.js"
    },
    "./runtime/scan": {
      "types": "./dist/runtime/scan.d.ts",
      "import": "./dist/runtime/scan.js"
    },
    "./checks/*": {
      "types": "./dist/checks/*.d.ts",
      "import": "./dist/checks/*.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./contract/*": {
      "types": "./dist/contract/*.d.ts",
      "import": "./dist/contract/*.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "aria-query": "^5.3.2",
    "axobject-query": "^4.1.0",
    "fast-glob": "^3.3.3",
    "html-validate": "^11.12.0",
    "playwright": "^1.62.1",
    "ssrf-guard": "^0.6.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "axe-core": "^4.13.0"
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/complyloop/compliance-engineering-platform.git",
    "directory": "packages/analysis-core"
  },
  "license": "UNLICENSED"
}