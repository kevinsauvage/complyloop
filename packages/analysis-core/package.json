{
  "name": "@complyloop/analysis-core",
  "version": "0.1.0",
  "description": "ComplyLoop accessibility analysis engine — AST checks, runtime/DOM checks, findings contract. Framework-agnostic, reusable across platform, CI and browser.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "aria-query": "^5.3.2",
    "axobject-query": "^4.1.0",
    "eslint": "^10",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "html-validate": "^11.16.1",
    "linkinator": "^8.1.0",
    "playwright-core": "^1.63.0",
    "ssrf-guard": "1.0.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "axe-core": "^4.13.0"
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/complyloop/compliance-engineering-platform.git",
    "directory": "packages/analysis-core"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js",
        "default": "./dist/*.js"
      }
    }
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.70.1"
  }
}
