{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "composite": false,
    "incremental": false,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/runtime/custom-checks/playwright-test-teardown.ts",
    "dist"
  ]
}
