# Auth.js — required for Sign in with GitHub + repo connect.
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Required in production when GitHub auth is enabled (canonical app URL).
# Optional in local dev — Auth.js trusts the request host.
# AUTH_URL=http://localhost:3000
#
# OAuth scopes requested: read:user user:email repo
# (`repo` covers private clones, PR create, Check Runs). Prefer a GitHub App
# with tighter permissions before multi-tenant production.

# Persistent data directory (db.json, workspaces, encrypted github-tokens.json,
# webhook-deliveries.json). Defaults to ./.data — use a mounted volume in
# production (see docs/deploy.md).
# DATA_DIR=

# GitHub webhook HMAC secret (Settings → Webhooks → secret)
# Delivery URL: {origin}/api/github/webhook
# Events: push, pull_request (PR events also post a ComplyLoop Check Run)
# Deliveries are idempotent via x-github-delivery.
# GITHUB_WEBHOOK_SECRET=

# Optional — enables AI explanations and AI remediation suggestions
# AI_GATEWAY_API_KEY=
