# ComplyLoop environment template — copy to .env.local and fill in.
# Sections are ordered by setup flow. Required vars are uncommented;
# secrets and optional integrations are commented until needed.

# ─────────────────────────────────────────────────────────────
# Database (required)
# ─────────────────────────────────────────────────────────────
# Local example: run Postgres locally (e.g. docker run postgres:16-alpine
# on localhost:5433) && npm run db:migrate
# Wipe + remigrate (dev/pre-launch): npm run db:reset -- --confirm
DATABASE_URL=postgres://complyloop:complyloop@localhost:5433/complyloop
# With sslmode=require, server certs are verified by default.
# Private-CA hosts (e.g. Aiven): enable for local/dev until sslrootcert is wired.
# DATABASE_SSL_INSECURE=true

# ─────────────────────────────────────────────────────────────
# GitHub sign-in (required for connect)
# ─────────────────────────────────────────────────────────────
# Client ID / Secret of your GitHub App (https://github.com/settings/apps).
# Callback: {origin}/api/auth/callback/github
# AUTH_SECRET generation: openssl rand -base64 32
# Production refuses placeholder secrets (replace-me, e2e-secret-change-me).
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Private preview gate (HTTP Basic Auth on every page; APIs keep their own
# auth). Browsers cache the credential per origin. Leave unset locally.
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=
# Canonical app URL — required in production, optional in dev
# (Auth.js trusts the request host locally).
# AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# GitHub App (required in production when sign-in is on)
# ─────────────────────────────────────────────────────────────
# Permissions on GitHub: Contents R/W, Pull requests R/W, Checks R/W, Metadata R.
# Sign-in scopes are identity-only — repo access uses installation tokens.
# Private key PEM: literal newlines or `\n` escapes both work.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# Public App slug for the in-app install link
# (https://github.com/apps/<slug>/installations/new).
# GITHUB_APP_SLUG=

# ─────────────────────────────────────────────────────────────
# GitHub webhook (recommended — continuous re-assessment)
# ─────────────────────────────────────────────────────────────
# Delivery URL: {origin}/api/github/webhook — events: push, pull_request.
# PR events also post a ComplyLoop Check Run; deliveries are idempotent
# via the x-github-delivery header.
# GITHUB_WEBHOOK_SECRET=
# GitHub REST base URL override (GitHub Enterprise Server, or the local
# fixture API used by the webhook e2e to exercise Check Run posting).
# GITHUB_API_BASE_URL=

# ─────────────────────────────────────────────────────────────
# Assessment worker (GitHub Actions executor)
# ─────────────────────────────────────────────────────────────
# Trigger sites (dashboard action, webhook) only enqueue, then kick the
# `assessment-worker` workflow via repository_dispatch
# (`GH_WORKER_DISPATCH_TOKEN`: fine-grained PAT with Contents read+write on
# the app repo only — the documented requirement for the dispatch endpoint;
# target resolves from APP_REPO_FULL_NAME or Vercel's
# VERCEL_GIT_REPO_OWNER/SLUG). The workflow also runs every 15 min as the
# orphan/expired-lease backstop. There is no second executor: an
# unconfigured/rejected dispatch leaves the job queued for the schedule.
# GH_WORKER_DISPATCH_TOKEN=
# APP_REPO_FULL_NAME=owner/repo
# ASSESSMENT_MAX_CHECKOUT_BYTES=524288000
# ASSESSMENT_MAX_CHECKOUT_FILES=50000
# ASSESSMENT_MAX_CHECKOUT_SCAN_MS=30000
# ASSESSMENT_MAX_RUNTIME_PAGES=25

# ─────────────────────────────────────────────────────────────
# AI features (optional)
# ─────────────────────────────────────────────────────────────
# Enables AI explanations and remediation suggestions via the Vercel AI
# Gateway (model: minimax/minimax-m3). AI never sets compliance statuses.
# AI_GATEWAY_API_KEY=

# ─────────────────────────────────────────────────────────────
# Support & monitoring (optional)
# ─────────────────────────────────────────────────────────────
# Shown on the Organization page as the pilot support contact.
COMPLYLOOP_SUPPORT_EMAIL=support@example.com
# Sentry DSN for server/edge error capture (@sentry/nextjs).
# Structured JSON logs always go to stdout/stderr regardless.
# SENTRY_DSN=
# Same DSN in the browser (error boundaries, client exceptions).
# NEXT_PUBLIC_SENTRY_DSN=
# Trace sample rate 0–1 (default 0.05 in production when a DSN is set).
# SENTRY_TRACES_SAMPLE_RATE=0.05
# Build-time source map upload (leave unset to skip).
# SENTRY_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────
# Dev tunnel (optional, `npm run dev` only)
# ─────────────────────────────────────────────────────────────
# Without this, browsers on a tunnel host get 403s on `/_next/*` chunks:
# React never hydrates, so forms fall back to full-page posts with no
# pending label and no toast. Bare hosts only (schemes/paths are stripped);
# prefer a wildcard — ngrok free subdomains rotate on every restart.
# Restart `npm run dev` after changing this.
# ALLOWED_DEV_ORIGINS=*.ngrok-free.dev

# ─────────────────────────────────────────────────────────────
# Playwright e2e harness — NEVER set on real deployments
# ─────────────────────────────────────────────────────────────
# When enabled, assessments use a local fixture tree instead of cloning
# GitHub, and production GitHub App enforcement is skipped. Run: npm run test:e2e
# In NODE_ENV=production the server throws unless E2E_PROD_HARNESS=1, which is
# set only by playwright.config.ts on its dedicated e2e server.
# E2E_AUTH_ENABLED=1
# E2E_FIXTURE_ROOT=/absolute/path/to/e2e/fixtures/sample-app
# Cookie-secret override — Playwright does not read AUTH_SECRET in globalSetup.
# E2E_AUTH_SECRET=e2e-secret
