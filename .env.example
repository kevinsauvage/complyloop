# Auth.js — required for Sign in with GitHub + repo connect.
# Production: create a GitHub App (https://github.com/settings/apps) and use its
# Client ID / Client Secret here. Callback: {origin}/api/auth/callback/github
# Laptop demo: a classic OAuth App also works (requests the broad `repo` scope).
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Required in production when GitHub auth is enabled (canonical app URL).
# Optional in local dev — Auth.js trusts the request host.
# AUTH_URL=http://localhost:3000
#
# GitHub App (required in production when GitHub auth is on):
# Permissions: Contents R/W, Pull requests R/W, Checks R/W, Metadata R.
# Private key PEM — use literal newlines or `\n` escapes.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
#
# Scopes: with App → `read:user user:email` + installation tokens on selected
# repos only. Without App (dev) → also `repo` (full account access).

# Persistence: Postgres via Drizzle (required).
# Example local: docker compose up -d && npm run db:migrate
DATABASE_URL=postgres://complyloop:complyloop@localhost:5433/complyloop
# With sslmode=require, server certs are verified by default.
# Aiven (and similar private-CA hosts): set this for local/dev until sslrootcert is wired:
# DATABASE_SSL_INSECURE=true

# GitHub webhook HMAC secret (Settings → Webhooks → secret)
# Delivery URL: {origin}/api/github/webhook
# Events: push, pull_request (PR events also post a ComplyLoop Check Run)
# Deliveries are idempotent via x-github-delivery.
# GITHUB_WEBHOOK_SECRET=

# Optional — enables AI explanations and AI remediation suggestions
# AI_GATEWAY_API_KEY=

# Optional — Sentry DSN for server error capture (@sentry/node).
# Structured JSON logs always go to stdout/stderr regardless.
# SENTRY_DSN=

# Playwright e2e harness — NEVER set on real production deploys.
# When E2E_AUTH_ENABLED=1, assessments use a local fixture tree instead of
# cloning GitHub, and production GitHub App enforcement is skipped.
# E2E_AUTH_ENABLED=1
# E2E_FIXTURE_ROOT=/absolute/path/to/e2e/fixtures/sample-app
# Optional override for minted session cookies (defaults to "e2e-secret").
# Playwright does not read AUTH_SECRET from .env.local in globalSetup.
# E2E_AUTH_SECRET=e2e-secret
# Then: npm run test:e2e

