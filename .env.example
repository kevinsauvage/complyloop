# Auth.js — required for Sign in with GitHub + repo connect.
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Optional; defaults to the request host (set in production if needed)
# AUTH_URL=http://localhost:3000

# Persistent data directory (db.json, workspaces, encrypted github-tokens.json).
# Defaults to ./.data — use a mounted volume path in production (see docs/deploy.md).
# DATA_DIR=

# GitHub webhook HMAC secret (Settings → Webhooks → secret)
# Delivery URL: {origin}/api/github/webhook
# Events: push, pull_request (PR events also post a ComplyLoop Check Run)
# GITHUB_WEBHOOK_SECRET=

# Optional — enables AI explanations and AI remediation suggestions
# AI_GATEWAY_API_KEY=
